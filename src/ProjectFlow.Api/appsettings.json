{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=projectflow;Username=projectflow;Password=projectflow-local"
  },
  "Jwt": {
    "Secret": "local-development-secret-change-before-production-123456",
    "Issuer": "ProjectFlow.Api",
    "Audience": "ProjectFlow.Client",
    "ExpirationMinutes": 60
  },
  "Database": {
    "ApplyMigrations": true
  },
  "AttachmentStorage": {
    "RootPath": "uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [".pdf", ".png", ".jpg", ".jpeg", ".txt", ".csv", ".docx", ".xlsx"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

